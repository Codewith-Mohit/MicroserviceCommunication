{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Ansi",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProperty"
    ],
    "Properties": {
      "Application": "MicroserviceCommunication.UI",
      "Environment": "Development"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "MS1": "http://localhost:5001",
    "MS2": "http://localhost:5002",
    "MS3": "http://localhost:5003"
  },
  "Database": {
    "Server": "localhost",
    "Port": 5432,
    "Database": "microservices_db",
    "UserId": "postgres",
    "Password": "postgres"
  },
  "MessageBroker": {
    "Host": "localhost",
    "Port": 5672,
    "BrokerType": "RabbitMQ",
    "Username": "guest",
    "Password": "guest"
  }
}
